    script4.start()
def output(s):
    if entry.get() == 'Ошибка!':
        entry.delete(0, END)
    entry.insert(END, s)
def clear():
    entry.delete(0, END)
def backspase():
    primer = entry.get()    #получить поле ввода
    entry.delete(0, END)
    entry.insert(0, primer[:-1])
def result():
    primer = entry.get()
    entry.delete(0, END)
    b = ''
    if "|" in primer:
        while '|' in primer:
            primer = primer.replace('|', 'abs(', 1)
            primer = primer.replace('|', ')', 1)
    if '!' in primer:
        for i in range(len(primer)):
            if primer[i] == '!':
                for j in range(len(b) - 1, -1, -1):
                    if b[j] in '+-/*':
                        b = b[:j + 1] + 'math.factorial(' + b[j + 1:] + ')'
                        break
                    if j ==0:
                        b = 'math.factorial(' + b + ')'
                        break
            else:
                b += primer[i]
        primer = b
    if '%' in primer:
        for i in range(len(primer)):
            if primer[i] == '%':
                do = primer[:i]
                j = i - 1
                if do[-1] == ')':
                    ks = 1
                    while True:
                        j -= 1
                        if j < 0 or ks == 0:
                            break
                        if do[j] == ')':
                            ks += 1
                        if do[j] == '(':
                            ks -= 1
                    print(do[j + 1:i])
                else:
                    while True:
                        if do[j] in '+-/*' or j < 0:
                            break
                        j = j - 1
                    print(do[j + 1:i])
        d = len(primer) - 1
        while d >= 0:
            if primer[d] == '%':
                l = d - 1
                while l >= 0 and (primer[l].isdigit() or primer[l] == '.'):
                    l -= 1
                l += 1
                e0 = float(primer[l:d])
                r = d + 1
                while r < len(primer) and (primer[r].isdigit() or primer[r] == '.'):
                    r += 1
                if r > d + 1:
                    e1 = float(primer[d + 1:r])
                else:
                    e1 = e0
                E = e0 * e1 / 100
                primer = primer[:l] + f'{E}' + primer[r:]
                d = l - 1
            else:
                d -= 1
    try:
        entry.insert(0, eval(primer))
        print(primer)
    except:
        entry.insert(0, 'Ошибка!')
        print(primer)
    b = ''
def primresult():
    primer = entry.get()
    entry.delete(0, END)
    c = 0
    b = ''
    if "|" in primer:
        c = 0
        for i in range(len(primer)):
            if primer[i] == "|":
                if c == 0:
                    c = 1
                    b = b + 'abs('
                else:
                    c = 0
                    b = b + ')'
            else:
                b += primer[i]
        primer = b
    if '!' in primer:
        for i in range(len(primer)):
            if primer[i] == '!':
                for j in range(len(b) - 1, -1, -1):
                    if b[j] in '+-/*':
                        b = b[:j + 1] + 'math.factorial(' + b[j + 1:] + ')'
                        break
                    if j == 0:
                        b = 'math.factorial(' + b + ')'
                        break
            else:
                b += primer[i]
        primer = b

    try:
        otvet = eval(primer)
        if otvet - int(otvet) >= 0.5:
            entry.insert(0, int(otvet) + 1)
        else:
            entry.insert(0, int(otvet))
    except:
        entry.insert(0, 'Ошибка!')
    b = ''
def znak():
    primer = entry.get()
    for i in range(len(primer)-1, -1, -1):
        if not primer[i].isdigit() or primer[i] == ')':
            if primer[i] == '+':
                entry.delete(i, i+1)
                entry.insert(i, '-')
                break
            elif primer[i] == '-':
                if primer[i-1] == '(':
                    entry.delete(i-1, i+1)
                    primer = entry.get()
                    entry.delete(0, END)
                    entry.insert(0, primer[:-1])
                    break
                else:
                    entry.delete(i, i+1)
                    entry.insert(i, '+')
                    break
            elif primer[i]!=')':
                entry.insert(i+1, '(-')
                entry.insert(END, ')')
                break

